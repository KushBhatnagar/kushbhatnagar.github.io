{{- /* /posts.json — published blog posts only (section "posts"; Tech Digest issues excluded).
       Read by scripts/kit_weekly_roundup.py (Sunday weekly letter). */ -}}
{{- $items := slice }}
{{- range (where site.RegularPages "Section" "posts").ByDate.Reverse }}
  {{- $img := "" }}
  {{- with partial "templates/_funcs/get-page-images" . }}{{ $img = (index . 0).Permalink }}{{ end }}
  {{- $items = $items | append (dict
      "url" .Permalink
      "title" (.Title | plainify)
      "summary" (.Description | default .Summary | plainify | htmlUnescape)
      "image" $img
      "date" (.Date.Format "2006-01-02")
      "categories" (.Params.categories | default slice)) }}
{{- end }}
{{- dict "posts" $items | jsonify (dict "indent" "  ") }}
